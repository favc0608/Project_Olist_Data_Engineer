A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="1348" width="26" height="16" as="geometry" /></mxCell><mxCell id="c63" value="Orquestación" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1242" y="1347" width="200" height="18" as="geometry" /></mxCell><mxCell id="c64" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="1370" width="26" height="16" as="geometry" /></mxCell><mxCell id="c65" value="Fuente web de competencia" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1242" y="1369" width="200" height="18" as="geometry" /></mxCell><mxCell id="c66" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="1392" width="26" height="16" as="geometry" /></mxCell><mxCell id="c67" value="Nota / regla" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1242" y="1391" width="200" height="18" as="geometry" /></mxCell><mxCell id="c68" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1414" width="26" height="16" as="geometry" /></mxCell><mxCell id="c69" value="Borde verde: hecho y probado" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1242" y="1413" width="200" height="18" as="geometry" /></mxCell><mxCell id="c70" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1436" width="26" height="16" as="geometry" /></mxCell><mxCell id="c71" value="Borde naranja: funciona con fallas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1242" y="1435" width="200" height="18" as="geometry" /></mxCell><mxCell id="c72" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="1458" width="26" height="16" as="geometry" /></mxCell><mxCell id="c73" value="Borde rojo: pendiente" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1242" y="1457" width="200" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="6. SCD y modelo de datos" id="6._SCD_y_modelo_de_d"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;Estrategia SCD (requisito del curso) y modelo de datos de Olist&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;SCD1 = se sobrescribe con lo último · SCD2 = se guarda la historia con vigencias · hechos unidos a la versión vigente en la fecha de compra&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=#263238;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2360" height="56" as="geometry" /></mxCell><mxCell id="c2" value="SCD TIPO 1 (sobrescribe)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="760" height="700" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Patrón&lt;/b&gt;: deduplicar por clave (último _ingested_at / estado más avanzado) → row_hash = sha2(columnas de negocio) → Delta MERGE: whenMatched (solo si cambia row_hash) update · whenNotMatched insert" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="720" height="170" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Tablas SCD1&lt;/b&gt;&lt;br&gt;· silver orders (clave order_id; desempate por rango de estado) ✔&lt;br&gt;· silver order_items (order_id + order_item_id) ✔&lt;br&gt;· silver payments (order_id + payment_sequential) ✔&lt;br&gt;· silver reviews (review_id + order_id) ✔&lt;br&gt;· silver customers (customer_id, row_hash) ✔&lt;br&gt;· silver productos (product_id, row_hash) ✔&lt;br&gt;· web silver productos_competencia ✔&lt;br&gt;· category_translation ✔" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="720" height="300" as="geometry" /></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6" value="SCD TIPO 2 (historia)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="800" height="700" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Columnas comunes&lt;/b&gt;: valid_from · valid_to (nulo = vigente) · is_current · row_hash&lt;br&gt;nueva versión solo si cambian los atributos historizados · cierre de la versión anterior (valid_to = valid_from nueva)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="760" height="170" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Clientes (customers_scd2)&lt;/b&gt;&lt;br&gt;persona = customer_unique_id (customer_id cambia en cada pedido)&lt;br&gt;atributos: zip, ciudad, estado&lt;br&gt;valid_from = fecha de compra del primer pedido con esa dirección&lt;br&gt;sk_cliente = sha2(unique_id ‖ valid_from)&lt;br&gt;recalcula la historia y aplica MERGE (inserta, cierra, borra versiones inválidas)&lt;br&gt;89 personas con historia en 2016-2017 (252 en todo el dataset)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="370" height="300" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;Sellers (silver_sellers)&lt;/b&gt;&lt;br&gt;valid_from = inicio del periodo del lote · zip texto de 5 dígitos&lt;br&gt;sk_vendedor = sha2(seller_id ‖ valid_from)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="320" width="370" height="140" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Precios de la competencia&lt;/b&gt;&lt;br&gt;clave tienda + sku_loja · valid_from = hora de captura · solo capturas válidas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="480" width="370" height="140" as="geometry" /></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="UNIÓN CON LOS HECHOS (gold)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1620" y="90" width="760" height="700" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;Regla&lt;/b&gt;: hecho.fecha_compra ∈ [dim.valid_from, coalesce(dim.valid_to, 9999-12-31))&lt;br&gt;→ la venta queda con la dirección que tenía el cliente ese día (no la actual)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="130" width="720" height="140" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;Línea de tiempo en gold&lt;/b&gt;&lt;br&gt;histórico desplazado 418 semanas: 2016-09-04..2018-08-31 → 2024-09-08..2026-09-04&lt;br&gt;conserva el día de la semana; Black Friday 2017 → 2025-11-28&lt;br&gt;2018-09/10 excluidos · silver conserva fechas originales · streaming desde 2026-09-04" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="290" width="720" height="170" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Modelo estrella (gold)&lt;/b&gt;&lt;br&gt;gold_dim_fecha · gold_dim_cliente_scd2 · gold_dim_vendedor_scd2 · gold_dim_products · gold_geolocation&lt;br&gt;gold_fact_sales · fact_payments · gold_fact_entregas · gold_fact_resenas · vistas gold_v_competencia_*" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1640" y="480" width="720" height="140" as="geometry" /></mxCell><mxCell id="c18" value="sk_cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="RELACIONES DEL DATASET OLIST (integridad referencial perfecta)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="2360" height="640" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;orders&lt;/b&gt; 99,441&lt;br&gt;PK order_id&lt;br&gt;customer_id, order_status, 5 fechas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="870" width="380" height="120" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;customers&lt;/b&gt; 99,441&lt;br&gt;PK customer_id&lt;br&gt;customer_unique_id, zip, ciudad, estado" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="870" width="380" height="120" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;order_items&lt;/b&gt; 112,650&lt;br&gt;PK order_id + order_item_id&lt;br&gt;product_id, seller_id, price, freight" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1090" width="380" height="120" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;order_payments&lt;/b&gt; 103,886&lt;br&gt;PK order_id + payment_sequential&lt;br&gt;tipo, cuotas, valor" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="870" width="380" height="120" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;order_reviews&lt;/b&gt; 99,224&lt;br&gt;PK review_id + order_id&lt;br&gt;score, título, mensaje" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="1090" width="380" height="120" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;products&lt;/b&gt; 32,951&lt;br&gt;PK product_id&lt;br&gt;categoría, dimensiones" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="1090" width="380" height="120" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;sellers&lt;/b&gt; 3,095&lt;br&gt;PK seller_id&lt;br&gt;zip, ciudad, estado" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1290" width="380" height="120" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;geolocation&lt;/b&gt; 1,000,163&lt;br&gt;sin clave: agregar por zip (19,015)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="1290" width="380" height="100" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b&gt;category_translation&lt;/b&gt; 71&lt;br&gt;PK product_category_name" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="1290" width="380" height="120" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;precios_competencia&lt;/b&gt; (web)&lt;br&gt;tienda + sku_loja → sku_olist" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2000" y="1090" width="380" height="120" as="geometry" /></mxCell><mxCell id="c31" value="customer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c32" value="order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c33" value="order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c34" value="order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c35" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" value="seller_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" value="zip_code_prefix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c38" value="zip_code_prefix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c39" value="product_category_name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c40" value="sku_olist = product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="Leyenda" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=11;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1470" width="250" height="280" as="geometry" /></mxCell><mxCell id="c42" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1504" width="26" height="16" as="geometry" /></mxCell><mxCell id="c43" value="Fuente / actor externo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1503" width="200" height="18" as="geometry" /></mxCell><mxCell id="c44" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1526" width="26" height="16" as="geometry" /></mxCell><mxCell id="c45" value="Streaming (SQS + Lambda)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1525" width="200" height="18" as="geometry" /></mxCell><mxCell id="c46" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1548" width="26" height="16" as="geometry" /></mxCell><mxCell id="c47" value="Landing (archivos crudos)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1547" width="200" height="18" as="geometry" /></mxCell><mxCell id="c48" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeColor=#A0522D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1570" width="26" height="16" as="geometry" /></mxCell><mxCell id="c49" value="Bronze (Parquet append)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1569" width="200" height="18" as="geometry" /></mxCell><mxCell id="c50" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1592" width="26" height="16" as="geometry" /></mxCell><mxCell id="c51" value="Silver (Delta, SCD1/SCD2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1591" width="200" height="18" as="geometry" /></mxCell><mxCell id="c52" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1614" width="26" height="16" as="geometry" /></mxCell><mxCell id="c53" value="Gold (hechos y dimensiones)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1613" width="200" height="18" as="geometry" /></mxCell><mxCell id="c54" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1636" width="26" height="16" as="geometry" /></mxCell><mxCell id="c55" value="Consumo (Athena / Power BI)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1635" width="200" height="18" as="geometry" /></mxCell><mxCell id="c56" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1658" width="26" height="16" as="geometry" /></mxCell><mxCell id="c57" value="Orquestación" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1657" width="200" height="18" as="geometry" /></mxCell><mxCell id="c58" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1680" width="26" height="16" as="geometry" /></mxCell><mxCell id="c59" value="Fuente web de competencia" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1679" width="200" height="18" as="geometry" /></mxCell><mxCell id="c60" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1702" width="26" height="16" as="geometry" /></mxCell><mxCell id="c61" value="Nota / regla" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1701" width="200" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="7. Infraestructura y seguridad" id="7._Infraestructura_y"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;Infraestructura como código, seguridad y costos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Cuenta AWS compartida con otros alumnos · región us-east-2 · todo recurso propio con prefijo g1- / g1_ · despliegue con change sets revisados&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=#263238;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2360" height="56" as="geometry" /></mxCell><mxCell id="c2" value="STACKS CLOUDFORMATION" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1500" height="640" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;g1-olist-streaming&lt;/b&gt; · infra/cloudformation/g1-olist-streaming.yaml&lt;br&gt;SQS g1-olist-eventos + DLQ · Lambda g1-olist-consumidor (código desde S3, CodigoConsumidorKey) · trigger SQS · usuario IAM g1-olist-colab-productor (solo SendMessage) · rol g1-olist-glue-role · workgroup Athena g1-olist · alarmas CloudWatch · parámetro PrefijoLanding = erp/landing/" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1460" height="170" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;g1-olist-web&lt;/b&gt; · infra/cloudformation/g1-olist-web.yaml&lt;br&gt;bucket g1-olist-competencia-web (privado) · CloudFront + OAC + cabeceras · SQS g1-olist-web-cambios.fifo y g1-olist-web-cambios-sitio (+ DLQ) · Lambdas g1-olist-web-publicador y g1-olist-web-scraper · Schedulers 05:00 y 06:00 Lima · roles por Lambda" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="1460" height="170" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;g1-olist-orquestacion&lt;/b&gt; · infra/cloudformation/g1-olist-orquestacion.yaml&lt;br&gt;Lambda g1-olist-orquestador · Step Functions g1-olist-pipeline · reglas g1-olist-archivos-nuevos y g1-olist-fin-pipeline · Schedulers cada 3 h y cada 10 min · 3 roles de permisos mínimos · parámetros EstadoDisparadores, IntervaloMinimoMin, ExpresionHorario, MaxFallosSeguidos, IncluirGoldVentas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1460" height="170" as="geometry" /></mxCell><mxCell id="c6" value="DESPLIEGUE" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1550" y="90" width="830" height="640" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;1. Empaquetar&lt;/b&gt;: infra/scripts/empaquetar_lambda.py → artefactos/lambda/&amp;lt;lambda&amp;gt;-&amp;lt;hash&amp;gt;.zip (nombre por contenido)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1570" y="130" width="790" height="90" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;2. Subir&lt;/b&gt;: AWS CLI o URL prefirmada + infra/scripts/subir_presignado.py → s3://&amp;lt;bucket&amp;gt;/artefactos/" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1570" y="240" width="790" height="90" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;3. Validar&lt;/b&gt;: CI (lint + 46 pruebas) · ValidateStateMachineDefinition · revisar el change set (sin Remove ni Replacement)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1570" y="350" width="790" height="90" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;4. Aplicar&lt;/b&gt;: ExecuteChangeSet · respaldo previo de lo que se reemplaza" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1570" y="460" width="790" height="90" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Jobs de Glue&lt;/b&gt;: infra/scripts/crear_jobs_glue.py sube glue/*.py a s3://aws-glue-assets-…/scripts/ y crea o actualiza los 28 jobs&lt;br&gt;antes de editar en la consola, bajar el script vigente" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1570" y="570" width="790" height="130" as="geometry" /></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="SEGURIDAD Y RESTRICCIONES" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1180" height="680" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;Cuenta compartida&lt;/b&gt;: prefijo g1-/g1_ en todo; no tocar recursos ajenos ni el grupo IAM compartido&lt;br&gt;&lt;b&gt;Bucket del lakehouse&lt;/b&gt;: nunca público · el sitio web va en un bucket aparte servido por CloudFront con OAC&lt;br&gt;&lt;b&gt;Productor del Colab&lt;/b&gt;: usuario IAM con una sola acción (sqs:SendMessage sobre g1-olist-eventos); la access key se sube al Colab y se lee en memoria; los CSV de credenciales nunca se versionan (.gitignore) ni se leen&lt;br&gt;&lt;b&gt;Repos públicos&lt;/b&gt; (DMC_G1_SAAS, Scraping_Competencia): solo la herramienta; sin número de cuenta, usuarios ni credenciales (la cola se busca por nombre)&lt;br&gt;&lt;b&gt;Roles&lt;/b&gt;: roles por servicio; jobs nuevos con g1-olist-glue-role (los más antiguos usan un rol heredado más amplio: siguiente paso migrarlos)&lt;br&gt;&lt;b&gt;Restricciones de la cuenta&lt;/b&gt;: no se pueden crear log groups (sin logs en Step Functions; los de Lambda los crea su rol) · concurrencia de Lambda de la cuenta = 10 (sin ReservedConcurrentExecutions) · políticas SQS con un recurso por sentencia · Kinesis, Firehose y Redshift Serverless no habilitados · RDS descartado por costo · sin Route 53&lt;br&gt;&lt;b&gt;Secretos&lt;/b&gt;: nunca get-secret-value; las URL prefirmadas caducan en 15 min&lt;br&gt;&lt;b&gt;Marcas&lt;/b&gt;: tiendas ficticias, sin marcas reales en texto visible" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1140" height="620" as="geometry" /></mxCell><mxCell id="c17" value="COSTOS APROXIMADOS" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1230" y="760" width="1150" height="680" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;Streaming&lt;/b&gt; (SQS + Lambda + S3): ≈ USD 0-1 / mes&lt;br&gt;&lt;b&gt;Web&lt;/b&gt; (CloudFront + Lambdas + S3): centavos / mes&lt;br&gt;&lt;b&gt;Orquestación&lt;/b&gt; (EventBridge, Scheduler, Lambda, Step Functions): ≈ USD 0 (capa gratuita)&lt;br&gt;&lt;b&gt;Glue&lt;/b&gt;: el costo principal · ≈ USD 0.44 por DPU-hora · ≈ USD 0.03-0.05 por job y corrida (mínimo 1 min) · ciclo ERP completo ≈ USD 0.22 · ciclo web ≈ USD 0.09 · FLEX es más barato pero sin capacidad garantizada: el pipeline usa STANDARD&lt;br&gt;&lt;b&gt;Crawlers&lt;/b&gt;: mínimo 10 min por corrida (≈ USD 0.07-0.15): usar projection en vez de crawlers frecuentes&lt;br&gt;&lt;b&gt;Athena&lt;/b&gt;: USD 5 por TB escaneado · límite 1 GB por consulta en el workgroup" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1250" y="800" width="1110" height="380" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;Palancas de costo&lt;/b&gt;: intervalo mínimo 120 min (≤ 12 ciclos automáticos/día) · freno tras 2 fallos seguidos · solo corren los jobs de entidades con archivos nuevos · ciclo sin trabajo = USD 0 · scraper diario + bajo demanda · caché CloudFront 60 s&lt;br&gt;&lt;b&gt;Pruebas&lt;/b&gt;: tests/ (41: Lambdas, web, orquestador) · competencia/tests (5) · CI en GitHub Actions" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1250" y="1200" width="1110" height="220" as="geometry" /></mxCell><mxCell id="c20" value="Leyenda" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=11;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1470" width="250" height="280" as="geometry" /></mxCell><mxCell id="c21" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1504" width="26" height="16" as="geometry" /></mxCell><mxCell id="c22" value="Fuente / actor externo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1503" width="200" height="18" as="geometry" /></mxCell><mxCell id="c23" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1526" width="26" height="16" as="geometry" /></mxCell><mxCell id="c24" value="Streaming (SQS + Lambda)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1525" width="200" height="18" as="geometry" /></mxCell><mxCell id="c25" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1548" width="26" height="16" as="geometry" /></mxCell><mxCell id="c26" value="Landing (archivos crudos)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1547" width="200" height="18" as="geometry" /></mxCell><mxCell id="c27" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeColor=#A0522D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1570" width="26" height="16" as="geometry" /></mxCell><mxCell id="c28" value="Bronze (Parquet append)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1569" width="200" height="18" as="geometry" /></mxCell><mxCell id="c29" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1592" width="26" height="16" as="geometry" /></mxCell><mxCell id="c30" value="Silver (Delta, SCD1/SCD2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1591" width="200" height="18" as="geometry" /></mxCell><mxCell id="c31" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1614" width="26" height="16" as="geometry" /></mxCell><mxCell id="c32" value="Gold (hechos y dimensiones)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1613" width="200" height="18" as="geometry" /></mxCell><mxCell id="c33" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1636" width="26" height="16" as="geometry" /></mxCell><mxCell id="c34" value="Consumo (Athena / Power BI)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1635" width="200" height="18" as="geometry" /></mxCell><mxCell id="c35" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1658" width="26" height="16" as="geometry" /></mxCell><mxCell id="c36" value="Orquestación" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1657" width="200" height="18" as="geometry" /></mxCell><mxCell id="c37" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1680" width="26" height="16" as="geometry" /></mxCell><mxCell id="c38" value="Fuente web de competencia" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1679" width="200" height="18" as="geometry" /></mxCell><mxCell id="c39" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1702" width="26" height="16" as="geometry" /></mxCell><mxCell id="c40" value="Nota / regla" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1">