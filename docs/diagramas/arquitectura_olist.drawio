</mxCell><mxCell id="c56" value="&lt;b&gt;g1_olist_gold_entregas&lt;/b&gt; → gold_fact_entregas (pedido: tiempos, atraso, ruta, flete, sk SCD2)&lt;br&gt;&lt;b&gt;g1_olist_gold_resenas&lt;/b&gt; → gold_fact_resenas (reseña + atraso de la entrega)&lt;br&gt;controles: duplicados y huérfanos sk_cliente" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="860" width="520" height="170" as="geometry" /></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c29" target="c52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c44" target="c53"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c54"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c34" target="c55"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c63" value="&lt;b&gt;Glue Data Catalog&lt;/b&gt;&lt;br&gt;base g1_olist_lakehouse&lt;br&gt;&amp;lt;capa&amp;gt;_&amp;lt;entidad&amp;gt;: bronze_*, silver_*, gold_*, fact_payments, web_*, erp_landing_*" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2090" y="140" width="290" height="180" as="geometry" /></mxCell><mxCell id="c64" value="&lt;b&gt;Registro de tablas&lt;/b&gt;&lt;br&gt;Delta = tabla nativa de Athena (lee el esquema del log)&lt;br&gt;eventos del streaming = partition projection&lt;br&gt;crawlers solo si cambian columnas (cobran ≥ 10 min)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2090" y="350" width="290" height="200" as="geometry" /></mxCell><mxCell id="c65" value="&lt;b&gt;Athena&lt;/b&gt; workgroup g1-olist&lt;br&gt;estado &lt;b&gt;Controles&lt;/b&gt; del pipeline: 11 reglas (duplicados, vigencias SCD2, huérfanos)&lt;br&gt;(falla la ejecución si ≠ 0)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2090" y="580" width="290" height="160" as="geometry" /></mxCell><mxCell id="c66" value="&lt;b&gt;Power BI&lt;/b&gt;&lt;br&gt;lee gold vía Athena (ODBC)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2090" y="770" width="290" height="120" as="geometry" /></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c52" target="c63"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c63" target="c65"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c65" target="c66"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c70" value="actualiza esquema" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c64" target="c63"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c71" value="&lt;b&gt;Contrato de cada job (convenciones)&lt;/b&gt;&lt;br&gt;· Glue 5.1, PySpark, 2 × G.1X, nombre g1_olist_&amp;lt;capa&amp;gt;_&amp;lt;entidad&amp;gt;&lt;br&gt;· valida antes de escribir (encabezados, nulos en claves, duplicados, conteos) y lanza ValueError si algo falla&lt;br&gt;· bronze: append + bookmark + _source_file + _ingested_at + year/month del periodo de negocio&lt;br&gt;· silver: Delta, dedupe por clave con el _ingested_at más reciente, row_hash, MERGE&lt;br&gt;· idempotente; termina OK sin datos nuevos (sin sys.exit); 0 reintentos internos (los hace Step Functions); clase STANDARD&lt;br&gt;· zips siempre texto de 5 dígitos; fechas yyyy-MM-dd HH:mm:ss" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="1610" width="820" height="260" as="geometry" /></mxCell><mxCell id="c72" value="&lt;b&gt;Hallazgos del dataset que respetar&lt;/b&gt;&lt;br&gt;· customer_id es único por pedido; la persona es customer_unique_id (96,096; 252 cambiaron de dirección)&lt;br&gt;· 97% delivered; 775 pedidos sin ítems; 160 sin order_approved_at&lt;br&gt;· review_id se repite 814 veces (clave review_id + order_id)&lt;br&gt;· geolocation: 261,831 filas duplicadas; agregar por zip&lt;br&gt;· products: columnas *_lenght (error de origen); 610 sin categoría&lt;br&gt;· 2016 y 2018-09/10 con pocos datos" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="860" y="1610" width="760" height="260" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;Siguientes pasos&lt;/b&gt;&lt;br&gt;1. cargar 2018 (el pipeline ya procesa un año en 15 min)&lt;br&gt;2. migrar los jobs antiguos al rol del proyecto (mínimo privilegio)&lt;br&gt;3. KMS propio para el bucket del lakehouse&lt;br&gt;4. recalcular el SCD2 solo para las claves del lote cuando el volumen crezca" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1640" y="1610" width="760" height="260" as="geometry" /></mxCell><mxCell id="c74" value="Leyenda" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=11;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="2420" y="90" width="250" height="346" as="geometry" /></mxCell><mxCell id="c75" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="124" width="26" height="16" as="geometry" /></mxCell><mxCell id="c76" value="Fuente / actor externo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="123" width="200" height="18" as="geometry" /></mxCell><mxCell id="c77" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="146" width="26" height="16" as="geometry" /></mxCell><mxCell id="c78" value="Streaming (SQS + Lambda)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="145" width="200" height="18" as="geometry" /></mxCell><mxCell id="c79" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="168" width="26" height="16" as="geometry" /></mxCell><mxCell id="c80" value="Landing (archivos crudos)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="167" width="200" height="18" as="geometry" /></mxCell><mxCell id="c81" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeColor=#A0522D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="190" width="26" height="16" as="geometry" /></mxCell><mxCell id="c82" value="Bronze (Parquet append)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="189" width="200" height="18" as="geometry" /></mxCell><mxCell id="c83" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="212" width="26" height="16" as="geometry" /></mxCell><mxCell id="c84" value="Silver (Delta, SCD1/SCD2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="211" width="200" height="18" as="geometry" /></mxCell><mxCell id="c85" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="234" width="26" height="16" as="geometry" /></mxCell><mxCell id="c86" value="Gold (hechos y dimensiones)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="233" width="200" height="18" as="geometry" /></mxCell><mxCell id="c87" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="256" width="26" height="16" as="geometry" /></mxCell><mxCell id="c88" value="Consumo (Athena / Power BI)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="255" width="200" height="18" as="geometry" /></mxCell><mxCell id="c89" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="278" width="26" height="16" as="geometry" /></mxCell><mxCell id="c90" value="Orquestación" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="277" width="200" height="18" as="geometry" /></mxCell><mxCell id="c91" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="300" width="26" height="16" as="geometry" /></mxCell><mxCell id="c92" value="Fuente web de competencia" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="299" width="200" height="18" as="geometry" /></mxCell><mxCell id="c93" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2430" y="322" width="26" height="16" as="geometry" /></mxCell><mxCell id="c94" value="Nota / regla" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="321" width="200" height="18" as="geometry" /></mxCell><mxCell id="c95" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2430" y="344" width="26" height="16" as="geometry" /></mxCell><mxCell id="c96" value="Borde verde: hecho y probado" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="343" width="200" height="18" as="geometry" /></mxCell><mxCell id="c97" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2430" y="366" width="26" height="16" as="geometry" /></mxCell><mxCell id="c98" value="Borde naranja: funciona con fallas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="365" width="200" height="18" as="geometry" /></mxCell><mxCell id="c99" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2430" y="388" width="26" height="16" as="geometry" /></mxCell><mxCell id="c100" value="Borde rojo: pendiente" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2462" y="387" width="200" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="4. Orquestación" id="4._Orquestación"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;Orquestación: EventBridge + Lambda orquestadora + Step Functions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Stack g1-olist-orquestacion · &quot;tiempo real en la ingesta, consolidación controlada en Glue&quot; · una sola ejecución a la vez&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=#263238;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2760" height="56" as="geometry" /></mxCell><mxCell id="c2" value="DISPARADORES (EventBridge)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="420" height="1000" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;S3 Object Created&lt;/b&gt;&lt;br&gt;bucket con EventBridgeConfiguration activo&lt;br&gt;→ regla &lt;b&gt;g1-olist-archivos-nuevos&lt;/b&gt;&lt;br&gt;claves: wildcard erp/landing/*.csv · prefix web/landing/precios/" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="380" height="130" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Scheduler g1-olist-pipeline-cada-3h&lt;/b&gt;&lt;br&gt;cron(0 */3 * * ? *) · America/Lima&lt;br&gt;parámetro ExpresionHorario (p. ej. rate(15 minutes))&lt;br&gt;input {&quot;origen&quot;: &quot;horario&quot;}" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="380" height="120" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Scheduler g1-olist-pipeline-pendientes&lt;/b&gt;&lt;br&gt;rate(10 minutes)&lt;br&gt;input {&quot;origen&quot;: &quot;revisar_pendiente&quot;}" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="380" height="110" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Regla g1-olist-fin-pipeline&lt;/b&gt;&lt;br&gt;Step Functions Execution Status Change&lt;br&gt;SUCCEEDED · FAILED · TIMED_OUT · ABORTED" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="380" height="120" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Acciones manuales&lt;/b&gt; (invocar la Lambda)&lt;br&gt;{&quot;accion&quot;:&quot;iniciar&quot;,&quot;entidades&quot;:[&quot;web&quot;]} → ignora intervalo, pausa y freno&lt;br&gt;{&quot;accion&quot;:&quot;pausar&quot;,&quot;minutos&quot;:60,&quot;por&quot;:&quot;…&quot;,&quot;motivo&quot;:&quot;…&quot;} (máx. 8 h, vence sola)&lt;br&gt;{&quot;accion&quot;:&quot;reanudar&quot;}&lt;br&gt;&lt;br&gt;&lt;b&gt;Consola de Step Functions&lt;/b&gt;: Start execution con {&quot;entidades&quot;:[…]} o {} (Preparar toma el candado)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="380" height="220" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Parámetros del stack&lt;/b&gt;&lt;br&gt;EstadoDisparadores = ENABLED / DISABLED&lt;br&gt;IntervaloMinimoMin = 120 · MaxFallosSeguidos = 2 · ExpresionHorario · CorreoAlertas" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="380" height="140" as="geometry" /></mxCell><mxCell id="c9" value="LAMBDA g1-olist-orquestador · árbol de decisión de un aviso" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="900" height="1000" as="geometry" /></mxCell><mxCell id="c10" value="aviso recibido" style="ellipse;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="260" height="60" as="geometry" /></mxCell><mxCell id="c11" value="¿origen S3?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="220" width="260" height="100" as="geometry" /></mxCell><mxCell id="c12" value="¿la clave es de una entidad del pipeline? (carpeta + .csv / .jsonl.gz)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="220" width="260" height="100" as="geometry" /></mxCell><mxCell id="c13" value="descartar: &quot;archivo fuera de las carpetas del pipeline&quot;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="235" width="240" height="70" as="geometry" /></mxCell><mxCell id="c14" value="¿inicio manual (accion: iniciar)?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="260" height="100" as="geometry" /></mxCell><mxCell id="c15" value="¿pausa manual vigente? (pausa.json)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="480" width="260" height="100" as="geometry" /></mxCell><mxCell id="c16" value="¿fallos_seguidos ≥ 2? (freno)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="610" width="260" height="100" as="geometry" /></mxCell><mxCell id="c17" value="¿pasaron 120 min desde el último inicio? (o pendiente por jobs ocupados)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="740" width="260" height="100" as="geometry" /></mxCell><mxCell id="c18" value="¿candado libre? escritura condicional If-None-Match" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="870" width="260" height="100" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;dejar pendiente.json&lt;/b&gt;&lt;br&gt;conserva la fecha del primer aviso&lt;br&gt;lo retoma el horario de 10 min o el fin de la ejecución en curso" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="610" width="240" height="110" as="geometry" /></mxCell><mxCell id="c20" value="¿candado vencido? (ejecución no RUNNING o &amp;gt; 3 h)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="870" width="240" height="100" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;StartExecution&lt;/b&gt;&lt;br&gt;pipeline-AAAAMMDDTHHMMSS-xxxx" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="1000" width="260" height="70" as="geometry" /></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" value="sí (forzar)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c30" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c31" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c32" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c34" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c35" value="sí: candado.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" value="sí: borrar y reintentar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c20" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c38" value="no: ya hay una en curso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c43" value="&lt;b&gt;Fin de ejecución&lt;/b&gt;&lt;br&gt;resumen en ejecuciones/&amp;lt;nombre&amp;gt;.json · contador de fallos (una vez por ejecución) · libera el candado · atiende pendiente" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="130" width="240" height="90" as="geometry" /></mxCell><mxCell id="c44" value="detalle name/status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c45" value="si hay pendiente → intentar iniciar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c43" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c46" value="STEP FUNCTIONS g1-olist-pipeline (Standard · timeout 2 h · sin logs: restricción de la cuenta)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1400" y="90" width="1380" height="1000" as="geometry" /></mxCell><mxCell id="c47" value="&lt;b&gt;Preparar&lt;/b&gt; (Lambda)&lt;br&gt;· si viene de la consola: toma el candado&lt;br&gt;· compara cada carpeta de landing con &lt;b&gt;su&lt;/b&gt; marca de agua (cortes por entidad)&lt;br&gt;· arma el plan de jobs&lt;br&gt;· si un job del plan ya corre a mano → plan vacío + pendiente (se reintenta en 10 min)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="130" width="300" height="150" as="geometry" /></mxCell><mxCell id="c48" value="HayTrabajo&lt;br&gt;¿hay_trabajo?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1780" y="160" width="200" height="100" as="geometry" /></mxCell><mxCell id="c49" value="&lt;b&gt;Bronze&lt;/b&gt; · Map paralelo máx. 4&lt;br&gt;g1_olist_bronze_orders · order_items · payments · reviews · customers · productos · sellers · geolocation · g1_olist_web_bronze_precios" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeColor=#A0522D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="330" width="300" height="170" as="geometry" /></mxCell><mxCell id="c50" value="&lt;b&gt;Silver&lt;/b&gt; · Map máx. 4 · tablas principales&lt;br&gt;g1_olist_silver_orders · silver_customers · silver_productos · silver_geolocation · web_silver_precios_competencia (SCD2) · web_silver_productos_competencia" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1780" y="330" width="300" height="170" as="geometry" /></mxCell><mxCell id="c51" value="&lt;b&gt;SilverDependiente&lt;/b&gt; · Map máx. 3&lt;br&gt;tablas hijas del pedido: silver_order_items · silver_payments · silver_reviews · silver_customers_scd2&lt;br&gt;&lt;i&gt;necesitan los pedidos ya en silver orders&lt;/i&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2130" y="330" width="300" height="170" as="geometry" /></mxCell><mxCell id="c52" value="&lt;b&gt;Gold&lt;/b&gt; · Map máx. 4 · por dependencia&lt;br&gt;ventas · dimensiones · entregas · reseñas · payments · geolocation&lt;br&gt;→ &lt;b&gt;Controles&lt;/b&gt; (Athena: 11 reglas) → Cerrar" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2130" y="560" width="300" height="130" as="geometry" /></mxCell><mxCell id="c53" value="&lt;b&gt;Cerrar&lt;/b&gt; (Lambda)&lt;br&gt;avanza la marca de agua SOLO de las entidades del plan&lt;br&gt;ultima_exitosa" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1780" y="580" width="300" height="110" as="geometry" /></mxCell><mxCell id="c54" value="Fin (Succeed)" style="ellipse;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1830" y="740" width="200" height="60" as="geometry" /></mxCell><mxCell id="c55" value="&lt;b&gt;RegistrarFallo&lt;/b&gt; (Lambda)&lt;br&gt;fallos/&amp;lt;nombre&amp;gt;.json · la marca de agua NO avanza&lt;br&gt;aviso: regla g1-olist-pipeline-fallido → SNS → correo" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="580" width="300" height="110" as="geometry" /></mxCell><mxCell id="c56" value="Fallo (PipelineFallido)" style="ellipse;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="740" width="200" height="60" as="geometry" /></mxCell><mxCell id="c57" value="input {origen, entidades, nombre}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c58" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c59" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c60" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c48" target="c53"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c66" value="Catch States.ALL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c49" target="c55"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c68" value="evento de fin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c54" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c69" value="&lt;b&gt;Cada job: glue:startJobRun.sync&lt;/b&gt; (Step Functions espera a que termine)&lt;br&gt;Retry 1: Glue.ConcurrentRunsExceededException → 8 intentos, 60 s × 1.5, máx. 300 s, jitter FULL (≈30 min: job ocupado por una corrida manual)&lt;br&gt;ExecutionClass STANDARD (FLEX no garantiza capacidad)&lt;br&gt;Retry 2: ThrottlingException / InternalServiceException → 3 intentos, 60 s × 2&lt;br&gt;Error de datos (ValueError del job) → sin reintento → RegistrarFallo&lt;br&gt;&lt;i&gt;JobRunQueuingEnabled (cola nativa de Glue) no lo acepta la integración de Step Functions&lt;/i&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="2130" y="740" width="620" height="190" as="geometry" /></mxCell><mxCell id="c70" value="&lt;b&gt;Ejemplo de plan&lt;/b&gt;: llegan orders + payments del Colab → bronze orders y payments → silver orders → silver payments → gold payments. Nada más (Glue solo cobra lo necesario).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ejecuciones medidas&lt;/b&gt;: año completo (70 lotes, 18 jobs) 15 min · semestre 14 min · web 4-6 min · una entidad 6-10 min · revisión de pendiente sin trabajo: 1 s, USD 0." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1430" y="830" width="650" height="240" as="geometry" /></mxCell><mxCell id="c71" value="CONTROL EN S3 · s3://trabajo-integrador-g1/erp/_control/orquestacion/" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFFFFF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="1350" height="420" as="geometry" /></mxCell><mxCell id="c72" value="&lt;b&gt;candado.json&lt;/b&gt;&lt;br&gt;{nombre, desde, origen}&lt;br&gt;una sola ejecución a la vez; creado con If-None-Match" style="shape=document;boundedLbl=1;size=0.12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="210" height="160" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;pendiente.json&lt;/b&gt;&lt;br&gt;{origen, desde, ultimo_aviso, sin_intervalo}&lt;br&gt;avisos sin atender" style="shape=document;boundedLbl=1;size=0.12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="262" y="1170" width="210" height="160" as="geometry" /></mxCell><mxCell id="c74" value="&lt;b&gt;pausa.json&lt;/b&gt;&lt;br&gt;{por, motivo, desde, hasta}&lt;br&gt;pausa manual (vence sola)" style="shape=document;boundedLbl=1;size=0.12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="484" y="1170" width="210" height="160" as="geometry" /></mxCell><mxCell id="c75" value="&lt;b&gt;ultima.json&lt;/b&gt;&lt;br&gt;{cortes por entidad (9), iniciada_en, ultima_exitosa, fallos_seguidos, ultimo_estado, ultima_contada}" style="shape=document;boundedLbl=1;size=0.12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="706" y="1170" width="210" height="160" as="geometry" /></mxCell><mxCell id="c76" value="&lt;b&gt;ejecuciones/&lt;/b&gt;&lt;br&gt;&amp;lt;nombre&amp;gt;.json: estado, inicio, fin de cada ejecución" style="shape=document;boundedLbl=1;size=0.12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="928" y="1170" width="210" height="160" as="geometry" /></mxCell><mxCell id="c77" value="&lt;b&gt;fallos/&lt;/b&gt;&lt;br&gt;&amp;lt;nombre&amp;gt;.json: job, error y causa (primer lugar a revisar)" style="shape=document;boundedLbl=1;size=0.12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="1170" width="210" height="160" as="geometry" /></mxCell><mxCell id="c78" value="&lt;b&gt;Por qué una Lambda entre EventBridge y Step Functions&lt;/b&gt;: el Colab escribe archivos cada minuto y un lote mensual sube decenas a la vez. Iniciar Step Functions por cada archivo encimaría ejecuciones sobre las mismas tablas Delta. La orquestadora agrupa avisos (candado + pendiente + intervalo), frena ante fallos repetidos (costo) y convive con corridas manuales (pausa, jobs ocupados).&lt;br&gt;&lt;b&gt;Regla de operación&lt;/b&gt;: para correr un job a mano, pausar antes o reprocesar vía la orquestadora." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="1310" height="170" as="geometry" /></mxCell><mxCell id="c79" value="PERMISOS MÍNIMOS (roles del stack)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1400" y="1120" width="1380" height="420" as="geometry" /></mxCell><mxCell id="c80" value="&lt;b&gt;g1-olist-orquestador-role&lt;/b&gt;&lt;br&gt;s3:ListBucket (erp/landing/*, web/landing/precios/*, _control)&lt;br&gt;s3:Get/Put/DeleteObject solo en erp/_control/orquestacion/*&lt;br&gt;states:StartExecution / DescribeExecution (esta máquina)&lt;br&gt;glue:GetJobRuns sobre job/g1_olist_* (solo lectura)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="1170" width="420" height="200" as="geometry" /></mxCell><mxCell id="c81" value="&lt;b&gt;g1-olist-pipeline-role&lt;/b&gt; (Step Functions)&lt;br&gt;glue:StartJobRun, GetJobRun, GetJobRuns, BatchStopJobRun sobre job/g1_olist_*&lt;br&gt;lambda:InvokeFunction (orquestadora)&lt;br&gt;condición aws:SourceAccount" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1870" y="1170" width="420" height="200" as="geometry" /></mxCell><mxCell id="c82" value="&lt;b&gt;g1-olist-horario-pipeline-role&lt;/b&gt; (Scheduler)&lt;br&gt;lambda:InvokeFunction (orquestadora)&lt;br&gt;&lt;br&gt;&lt;b&gt;Permisos Lambda&lt;/b&gt;: events.amazonaws.com desde las 2 reglas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2310" y="1170" width="440" height="200" as="geometry" /></mxCell><mxCell id="c83" value="&lt;b&gt;Costos&lt;/b&gt;: EventBridge y Scheduler USD 0 · Lambda &amp;lt; 1,000 invocaciones/día (capa gratuita) · Step Functions Standard ~30 transiciones por ejecución (4,000 gratis/mes) · &lt;b&gt;Glue STANDARD ≈ USD 0.03-0.05 por job&lt;/b&gt; (≈ USD 0.30-0.50 un ciclo ERP completo, USD 0.09 uno web); el intervalo de 120 min acota a ≤ 12 ciclos automáticos/día" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1430" y="1390" width="1320" height="130" as="geometry" /></mxCell><mxCell id="c84" value="Leyenda" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=11;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1570" width="250" height="346" as="geometry" /></mxCell><mxCell id="c85" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1604" width="26" height="16" as="geometry" /></mxCell><mxCell id="c86" value="Fuente / actor externo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1603" width="200" height="18" as="geometry" /></mxCell><mxCell id="c87" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1626" width="26" height="16" as="geometry" /></mxCell><mxCell id="c88" value="Streaming (SQS + Lambda)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1625" width="200" height="18" as="geometry" /></mxCell><mxCell id="c89" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1648" width="26" height="16" as="geometry" /></mxCell><mxCell id="c90" value="Landing (archivos crudos)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="62" y="1647" width="200" height="18" as="geometry" /></mxCell><mxCell id="c91" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeCo