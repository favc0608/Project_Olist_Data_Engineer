<mxfile host="app.diagrams.net" agent="generar_drawio.py" version="24.0.0"><diagram name="1. Visión general" id="1._Visión_general"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;Proyecto Integrador DMC · Grupo 1 · Lakehouse Olist en AWS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Arquitectura medallion (landing → bronze → silver → gold) sobre el dataset de e-commerce de Olist · región us-east-2 · requisito del curso: SCD Tipo 1 y Tipo 2 · consumo en Power BI vía Athena&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=#263238;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2360" height="56" as="geometry" /></mxCell><mxCell id="c2" value="1. FUENTES" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="330" height="1000" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Dataset Kaggle Olist&lt;/b&gt;&lt;br&gt;~100k pedidos reales anonimizados 2016-2018&lt;br&gt;9 CSV: orders, order_items, payments, reviews, customers, products, sellers, geolocation, category_translation&lt;br&gt;copia local data/raw/olist/" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="290" height="110" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;ERP · lotes mensuales&lt;/b&gt;&lt;br&gt;CSV por entidad y mes de negocio (datos incrementales)&lt;br&gt;formato: erp/landing/&amp;lt;entidad&amp;gt;/year=AAAA/month=MM/&amp;lt;entidad&amp;gt;_AAAA_MM.csv&lt;br&gt;encabezados exactos de Olist" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="290" height="120" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Colab simulador&lt;/b&gt; (repo público DMC_G1_SAAS)&lt;br&gt;paquete olist_simulador &lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;ventas sintéticas desde 2026-09-04, reloj acelerado&lt;br&gt;eventos: pedido_creado/aprobado/enviado/entregado/cancelado, resena_creada, cliente_actualizado (contrato v2)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="290" height="130" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Sitios de competencia simulados&lt;/b&gt; (S3 + CloudFront)&lt;br&gt;d1wz0ixjw02i7c.cloudfront.net · 4 tiendas ficticias&lt;br&gt;48 productos Olist · BRL · pt-BR · ~60 páginas por tienda (competencia/generador)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="290" height="120" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Colab de cambios de precios&lt;/b&gt; (repo público Scraping_Competencia v1.1.0)&lt;br&gt;el usuario cambia precios/stock y ve lo que leyó el scraper" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="290" height="100" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Preguntas de negocio&lt;/b&gt;&lt;br&gt;01 categorías y productos más vendidos&lt;br&gt;02 cómo optimizar tiempos de entrega y logística&lt;br&gt;03 vendedores con mejor rendimiento histórico&lt;br&gt;&lt;br&gt;Resultado 2016-2017: 5.6% entregas tardías; reseña 4.28 a tiempo vs 2.32 tarde.&lt;br&gt;&lt;br&gt;Línea de tiempo: gold desplaza el histórico 418 semanas (2016-09-04..2018-08-31 → 2024-09-08..2026-09-04); el streaming continúa desde 2026-09-04." style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="290" height="260" as="geometry" /></mxCell><mxCell id="c9" value="2. INGESTA" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="330" height="1000" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Carga por lotes&lt;/b&gt;&lt;br&gt;scripts/generar_lotes_historicos.py (reproducible)&lt;br&gt;subida a S3 (consola, CLI o URL prefirmada)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="290" height="120" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Streaming&lt;/b&gt;&lt;br&gt;SQS Standard &lt;b&gt;g1-olist-eventos&lt;/b&gt; (DLQ tras 3 fallos)&lt;br&gt;→ Lambda &lt;b&gt;g1-olist-consumidor&lt;/b&gt; (lotes 1,000 / 60 s, concurrencia 2)&lt;br&gt;→ CSV formato Olist + copia cruda JSONL" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="290" height="130" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Scraping&lt;/b&gt;&lt;br&gt;Lambda &lt;b&gt;g1-olist-web-publicador&lt;/b&gt; (publica cambios)&lt;br&gt;Lambda &lt;b&gt;g1-olist-web-scraper&lt;/b&gt; (lee los 4 sitios por CloudFront)&lt;br&gt;disparo: Scheduler diario + S3 .html → SQS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="550" width="290" height="140" as="geometry" /></mxCell><mxCell id="c13" value="3. LAKEHOUSE · s3://trabajo-integrador-g1/ (privado) · catálogo Glue g1_olist_lakehouse" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#EEEEEE;strokeColor=#444444;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="1080" height="1000" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;LANDING&lt;/b&gt;&lt;br&gt;erp/landing/&amp;lt;entidad&amp;gt;/year=/month=/*.csv&lt;br&gt;erp/landing/eventos/ (JSONL)&lt;br&gt;erp/landing/rechazados/&lt;br&gt;web/landing/{precios,html,control,cambios}/&lt;br&gt;year=/month=/day=/" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="230" height="230" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;erp/bronze/&amp;lt;entidad&amp;gt;/&lt;br&gt;web/bronze/precios/&lt;br&gt;Parquet append&lt;br&gt;_source_file, _ingested_at&lt;br&gt;partición year/month (periodo de negocio)&lt;br&gt;job bookmark" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeColor=#A0522D;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="230" height="230" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;SILVER&lt;/b&gt;&lt;br&gt;erp/silver/&amp;lt;entidad&amp;gt;/&lt;br&gt;web/silver/...&lt;br&gt;Delta Lake&lt;br&gt;MERGE SCD1 (row_hash)&lt;br&gt;SCD2: sellers, clientes, precios&lt;br&gt;validaciones antes de escribir" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="230" height="230" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;GOLD&lt;/b&gt;&lt;br&gt;erp/gold/fact_payments, gold_geolocation, fact_sales&lt;br&gt;erp/gold/dim_products, dim_customers, dim_date (CTAS)&lt;br&gt;vistas Athena de competencia&lt;br&gt;fact_entregas, fact_resenas, dim_fecha, dims SCD2" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1550" y="150" width="240" height="230" as="geometry" /></mxCell><mxCell id="c18" value="Glue bronze&lt;br&gt;(solo archivos nuevos)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="Glue silver&lt;br&gt;dedupe + MERGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="Glue gold / CTAS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;AWS Glue 5.1 · PySpark · 2 × G.1X · 0 reintentos internos · timeout 30 min (jobs nuevos)&lt;/b&gt;&lt;br&gt;28 jobs g1_olist_*: bronze (9) · silver (10) · gold (6) · web (3) · lanzados en clase STANDARD&lt;br&gt;tablas Delta nativas en Athena (sin crawlers en cada corrida) · definición de jobs como código: infra/scripts/crear_jobs_glue.py" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="420" width="1020" height="150" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Control&lt;/b&gt; · erp/_control/orquestacion/ (candado, pendiente, pausa, marcas de agua, fallos) · web/bronze/_control/ y web/silver/_control/ (archivos ya procesados) · web/referencia/verdad/ (precios reales publicados)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="1020" height="110" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;ORQUESTACIÓN&lt;/b&gt; (stack g1-olist-orquestacion)&lt;br&gt;S3 Object Created → EventBridge regla &lt;b&gt;g1-olist-archivos-nuevos&lt;/b&gt; · Scheduler &lt;b&gt;cada 3 h&lt;/b&gt; (hora Lima) · Scheduler &lt;b&gt;cada 10 min&lt;/b&gt; (pendientes)&lt;br&gt;→ Lambda &lt;b&gt;g1-olist-orquestador&lt;/b&gt; (candado, intervalo 120 min, freno por fallos, pausa)&lt;br&gt;→ Step Functions &lt;b&gt;g1-olist-pipeline&lt;/b&gt;: Preparar → Bronze → Silver → SilverDependiente → Gold → Controles → Cerrar" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="740" width="1020" height="150" as="geometry" /></mxCell><mxCell id="c24" value="evento Object Created" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c14" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="glue:startJobRun.sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;Estado&lt;/b&gt;: histórico 2016-09..2017-12 cargado (45,444 pedidos, 51,252 ítems, 45,370 reseñas) · streaming → ERP funcionando · web completa (bronze → SCD2 → vistas gold) · un año completo (70 lotes) se procesa en 15 min · 11 controles de calidad en 0 · alertas por correo (SNS)" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770" y="920" width="1020" height="140" as="geometry" /></mxCell><mxCell id="c27" value="4. CONSUMO" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#B0E3E6;strokeColor=#0E8088;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1850" y="90" width="330" height="1000" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;Amazon Athena&lt;/b&gt;&lt;br&gt;workgroup &lt;b&gt;g1-olist&lt;/b&gt; (resultados en athena-resultados/, límite 1 GB)&lt;br&gt;tablas del catálogo + vistas gold_v_competencia_*&lt;br&gt;tablas de seguimiento erp_landing_eventos / rechazados" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1870" y="150" width="290" height="150" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b&gt;Power BI&lt;/b&gt;&lt;br&gt;conexión ODBC a Athena&lt;br&gt;lee las tablas gold&lt;br&gt;tablero de las 3 preguntas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1870" y="330" width="290" height="130" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;Interfaces de los Colab&lt;/b&gt;&lt;br&gt;simulador: estado de ventas en landing&lt;br&gt;competencia: precios actuales y precio leído por el scraper" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1870" y="490" width="290" height="110" as="geometry" /></mxCell><mxCell id="c31" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c32" value="ODBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c33" value="genera lotes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c34" value="CSV mensuales" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c35" value="SendMessage (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" value="HTML vía CloudFront" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mx