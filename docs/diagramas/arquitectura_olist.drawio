" vertex="1" parent="1"><mxGeometry x="40" y="690" width="420" height="140" as="geometry" /></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="PUBLICACIÓN" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="520" height="1050" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Colab Scraping_Competencia v1.1.0&lt;/b&gt; (repo público)&lt;br&gt;cambia precios / stock por tienda&lt;br&gt;tabla &quot;Precios actuales en la competencia&quot; (más barato con stock resaltado, refresco 60 s)&lt;br&gt;columna &quot;Leído por el scraper&quot;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="480" height="140" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;SQS FIFO g1-olist-web-cambios.fifo&lt;/b&gt;&lt;br&gt;MessageGroupId cambios-competencia · DLQ tras 3" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="480" height="90" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;Lambda g1-olist-web-publicador&lt;/b&gt;&lt;br&gt;Scheduler 05:00 Lima (publicación diaria) + cola FIFO&lt;br&gt;regenera páginas · guarda verdad en web/referencia/verdad/&amp;lt;version&amp;gt;.json + actual.json&lt;br&gt;_estado/publicacion.json" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="410" width="480" height="160" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Bucket g1-olist-competencia-web&lt;/b&gt; (privado)&lt;br&gt;sitio HTML+CSS · Cache-Control max-age=60&lt;br&gt;sin AGENTS.md, catalog_seed.json, scrapers/, tests/&lt;br&gt;_estado/{publicacion,scraping,precios}.json" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="600" width="480" height="150" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;CloudFront&lt;/b&gt; + OAC (S3 directo = 403)&lt;br&gt;https://d1wz0ixjw02i7c.cloudfront.net/ · caché 60 s&lt;br&gt;X-Robots-Tag: noindex, nofollow · HTTP → HTTPS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="780" width="480" height="130" as="geometry" /></mxCell><mxCell id="c16" value="subir sitio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="SendMessage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="lote ≤ 10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="PUT .html" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="origen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="SCRAPING" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="520" height="1050" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Disparadores del scraper&lt;/b&gt;&lt;br&gt;Scheduler 06:00 Lima (producción, cada 24 h)&lt;br&gt;S3 .html nuevo → SQS &lt;b&gt;g1-olist-web-cambios-sitio&lt;/b&gt; (lote 1,000 / 30 s, concurrencia 2, DLQ)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="480" height="120" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Lambda g1-olist-web-scraper&lt;/b&gt;&lt;br&gt;una corrida por versión (landing/control/en_curso.json)&lt;br&gt;invalida CloudFront antes de leer&lt;br&gt;lee las 4 tiendas · extrae precio BRL, lista, USD, descuento, stock&lt;br&gt;compara con la verdad: reglas R1-R4 por tienda · reglas_fallidas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="280" width="480" height="190" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;web/landing/&lt;/b&gt; year=/month=/day=/&lt;br&gt;precios/ (JSONL.gz, 176 filas por corrida)&lt;br&gt;html/ (copia de páginas)&lt;br&gt;control/ (reglas_ok por corrida)&lt;br&gt;cambios/" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="480" height="200" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Estado público&lt;/b&gt; (bucket del sitio)&lt;br&gt;_estado/scraping.json (último run, reglas_fallidas)&lt;br&gt;_estado/precios.json (campos públicos de la última corrida)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="730" width="480" height="120" as="geometry" /></mxCell><mxCell id="c26" value=".html ObjectCreated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c14" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c28" value="GET HTML" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="PUT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c30" value="PUT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c31" value="lee precio leído" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c25" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c32" value="LAKEHOUSE WEB (Glue STANDARD, rol g1-olist-glue-role)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1610" y="90" width="560" height="1050" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;g1_olist_web_bronze_precios&lt;/b&gt;&lt;br&gt;web/landing/precios → web/bronze/precios (Parquet)&lt;br&gt;esquema explícito · control por archivo en web/bronze/_control/archivos_precios/&lt;br&gt;columna reglas_ok desde web/landing/control" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F4D3B5;strokeColor=#A0522D;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="130" width="520" height="140" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;g1_olist_web_silver_precios_competencia&lt;/b&gt; · &lt;b&gt;SCD2&lt;/b&gt;&lt;br&gt;clave tienda + sku_loja · valid_from = hora de captura&lt;br&gt;solo capturas con reglas OK · 2 pasos: MERGE que cierra + append&lt;br&gt;control web/silver/_control/precios_competencia/&lt;br&gt;≈673 versiones, 176 vigentes" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="300" width="520" height="170" as="geometry" /></mxCell><mxCell id="c35" value="&lt;b&gt;g1_olist_web_silver_productos_competencia&lt;/b&gt; · SCD1&lt;br&gt;+ primera y última captura" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="500" width="520" height="110" as="geometry" /></mxCell><mxCell id="c36" value="&lt;b&gt;Vistas gold en Athena&lt;/b&gt; (infra/athena/web_tablas.sql)&lt;br&gt;gold_v_competencia_precio_actual (rank por producto)&lt;br&gt;gold_v_competencia_precio_diario (serie diaria hora Lima expandida del SCD2)&lt;br&gt;gold_v_competencia_resumen_tienda&lt;br&gt;controles W1-W3" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="640" width="520" height="200" as="geometry" /></mxCell><mxCell id="c37" value="Object Created → pipeline (entidad web)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="USO" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#B0E3E6;strokeColor=#0E8088;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="2200" y="90" width="360" height="1050" as="geometry" /></mxCell><mxCell id="c42" value="&lt;b&gt;Precio de Olist vs competencia&lt;/b&gt;&lt;br&gt;diferencia_pct por producto y tienda&lt;br&gt;cruce por sku_olist con products del ERP" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2220" y="140" width="320" height="140" as="geometry" /></mxCell><mxCell id="c43" value="&lt;b&gt;Power BI&lt;/b&gt; · precios de la competencia vía las vistas gold" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2220" y="310" width="320" height="110" as="geometry" /></mxCell><mxCell id="c44" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c36" target="c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c46" value="&lt;b&gt;Demo&lt;/b&gt;: cambiar un precio en el Colab → el publicador regenera la página → el scraper la lee (sin esperar al horario) → aparece en _estado/precios.json y, tras el pipeline web, en las vistas gold.&lt;br&gt;Pruebas: tests/test_lambdas_web.py · competencia/tests (unittest)." style="shape=note;size=14;html=1;whiteSpace