x="2210" y="234" width="26" height="16" as="geometry" /></mxCell><mxCell id="c53" value="Gold (hechos y dimensiones)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="233" width="200" height="18" as="geometry" /></mxCell><mxCell id="c54" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2210" y="256" width="26" height="16" as="geometry" /></mxCell><mxCell id="c55" value="Consumo (Athena / Power BI)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="255" width="200" height="18" as="geometry" /></mxCell><mxCell id="c56" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2210" y="278" width="26" height="16" as="geometry" /></mxCell><mxCell id="c57" value="Orquestación" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="277" width="200" height="18" as="geometry" /></mxCell><mxCell id="c58" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2210" y="300" width="26" height="16" as="geometry" /></mxCell><mxCell id="c59" value="Fuente web de competencia" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="299" width="200" height="18" as="geometry" /></mxCell><mxCell id="c60" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2210" y="322" width="26" height="16" as="geometry" /></mxCell><mxCell id="c61" value="Nota / regla" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="321" width="200" height="18" as="geometry" /></mxCell><mxCell id="c62" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="344" width="26" height="16" as="geometry" /></mxCell><mxCell id="c63" value="Borde verde: hecho y probado" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="343" width="200" height="18" as="geometry" /></mxCell><mxCell id="c64" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="366" width="26" height="16" as="geometry" /></mxCell><mxCell id="c65" value="Borde naranja: funciona con fallas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="365" width="200" height="18" as="geometry" /></mxCell><mxCell id="c66" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="388" width="26" height="16" as="geometry" /></mxCell><mxCell id="c67" value="Borde rojo: pendiente" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2242" y="387" width="200" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="2. Streaming en tiempo real" id="2._Streaming_en_tiem"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;Ingesta en tiempo real: Colab → SQS → Lambda → ERP landing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Stack g1-olist-streaming · contrato de mensaje v2 · SQS Standard a propósito (FIFO limita a lotes de 10 → archivos diminutos)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#444444;fontSize=11;align=center;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=#263238;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2360" height="56" as="geometry" /></mxCell><mxCell id="c2" value="Colab (Google)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="360" height="820" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Notebook simulador_olist_g1.ipynb&lt;/b&gt;&lt;br&gt;%pip install git+…DMC_G1_SAAS@v2.0.0&lt;br&gt;Simulador().mostrar()" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="90" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Credenciales&lt;/b&gt;&lt;br&gt;el usuario sube el CSV de access keys del usuario productor (se lee en memoria)&lt;br&gt;usuario IAM &lt;b&gt;g1-olist-colab-productor&lt;/b&gt;: solo sqs:SendMessage" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="110" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Generador&lt;/b&gt; (olist_simulador)&lt;br&gt;perfil estadístico de Olist (perfil.json.gz)&lt;br&gt;clientes, productos y vendedores reales + pedidos nuevos&lt;br&gt;evento_id determinista (uuid5): reenviar no duplica" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="320" height="140" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Mensaje (contrato v2)&lt;/b&gt;&lt;br&gt;{evento_id, tipo, ts_evento ISO-8601, version: 2, payload}&lt;br&gt;&lt;br&gt;tipos: pedido_creado (pedido, cliente, items, pagos) · pedido_aprobado · pedido_enviado · pedido_entregado · pedido_cancelado (traen la fila completa &lt;i&gt;pedido&lt;/i&gt;) · resena_creada · cliente_actualizado" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="320" height="170" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Interfaz del Colab&lt;/b&gt;&lt;br&gt;envío en tiempo real o ráfaga&lt;br&gt;consulta en Athena erp_landing_eventos para confirmar que las ventas llegaron" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="320" height="160" as="geometry" /></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" value="boto3 sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c11" value="Amazon SQS" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="400" height="820" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;g1-olist-eventos&lt;/b&gt; (Standard)&lt;br&gt;entrega al menos una vez y sin orden&lt;br&gt;visibilidad &amp;gt; timeout de la Lambda&lt;br&gt;alarmas de CloudWatch (antigüedad, DLQ)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="340" height="140" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;g1-olist-eventos-dlq&lt;/b&gt;&lt;br&gt;recibe lotes que fallaron 3 veces por infraestructura (p. ej. S3)&lt;br&gt;&lt;i&gt;los mensajes inválidos NO van aquí&lt;/i&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="520" width="340" height="110" as="geometry" /></mxCell><mxCell id="c14" value="SendMessageBatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="maxReceiveCount = 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="Lambda g1-olist-consumidor (python3.12, sin VPC)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="700" height="820" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Trigger SQS&lt;/b&gt;&lt;br&gt;BatchSize 1,000 · ventana 60 s&lt;br&gt;MaximumConcurrency 2 (cuenta: límite 10)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="130" width="300" height="90" as="geometry" /></mxCell><mxCell id="c18" value="¿mensaje válido?&lt;br&gt;(PAYLOAD_OBLIGATORIO del tipo)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="280" height="110" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;Rechazado&lt;/b&gt;&lt;br&gt;se guarda con _motivo&lt;br&gt;no bloquea el lote" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="260" width="300" height="90" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;Copia cruda&lt;/b&gt;&lt;br&gt;cada línea JSONL = evento + _message_id, _enviado_en, _recibido_en (UTC)&lt;br&gt;partición por llegada" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="400" width="300" height="110" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;erp_csv.py&lt;/b&gt; → CSV con columnas exactas de Olist&lt;br&gt;· colapsa cada pedido a su último estado del lote (ts_evento + rango created&amp;lt;approved&amp;lt;…&amp;lt;delivered&amp;lt;canceled)&lt;br&gt;· cliente solo desde pedido_creado (5 columnas)&lt;br&gt;· cliente_actualizado no genera fila&lt;br&gt;· zips de 5 dígitos como texto" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="540" width="300" height="170" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Periodo = mes de negocio&lt;/b&gt;&lt;br&gt;year/month = fecha de compra (reseñas: fecha de creación)&lt;br&gt;nombre: &amp;lt;entidad&amp;gt;_AAAA_MM_&amp;lt;AAAAMMDDTHHMMSS&amp;gt;_&amp;lt;id&amp;gt;.csv&lt;br&gt;un archivo por entidad y lote" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFE0;strokeColor=#B3B300;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="300" height="170" as="geometry" /></mxCell><mxCell id="c23" value="lote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="S3 · erp/landing/" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;opacity=100;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1600" y="90" width="560" height="820" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;erp/landing/rechazados/&lt;/b&gt; year=/month=/day=/hour=/ (JSONL con _motivo)" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="130" width="500" height="90" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;erp/landing/eventos/&lt;/b&gt; year=/month=/day=/hour=/ (JSONL crudo, auditoría)" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="250" width="500" height="90" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;CSV formato Olist&lt;/b&gt;&lt;br&gt;erp/landing/orders/year=/month=/orders_*.csv&lt;br&gt;erp/landing/order_items/…&lt;br&gt;erp/landing/payments/…&lt;br&gt;erp/landing/reviews/…&lt;br&gt;erp/landing/customers/… (5 columnas)&lt;br&gt;&lt;i&gt;los mismos jobs de bronze que leen los lotes del ERP&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;size=10;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="370" width="500" height="230" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;Athena (partition projection, sin crawler)&lt;/b&gt;&lt;br&gt;g1_olist_lakehouse.erp_landing_eventos · erp_landing_rechazados&lt;br&gt;payload como texto JSON → json_extract" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="630" width="500" height="120" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;EventBridge&lt;/b&gt;: cada CSV nuevo emite Object Created → orquestadora (página 4)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="770" width="500" height="110" as="geometry" /></mxCell><mxCell id="c35" value="PUT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" value="PUT .jsonl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" value="PUT .csv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c39" value="Object Created" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=9;label